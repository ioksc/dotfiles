# i3blocks config file
#
# Consult http://i3wm.org/i3blocks for more details

# Global properties
separator=false
color=#c0caf5
separator_block_width=9
markup=pango

[arch_update]
command=~/dotfiles/scripts/new_arch_updates.sh
interval=once
label=<span color="#4781ecff"> </span>
color=#4781ecff

[cpu_temp]
command=sensors | awk '/Core [0-9]+/ {print $3}' | sort -nr | head -1
interval=10
label=<span color="#bb9af7"> </span>
color=#bb9af7

[redshift]
command=~/dotfiles/scripts/redshift-toogle.sh
interval=once
color=#9ece6a

[headset_battery]
command=/home/ioksc/dotfiles/scripts/my-headphone.sh
interval=5
label=<span color="#7aa2f7"></span>
color=#7aa2f7

[keyboard]
command=~/dotfiles/scripts/keyboard_layout.sh
interval=once
label=<span color="#7dcfff">  </span>
color=#7dcfff

[cpu]
command=mpstat 1 1 | awk '/all/ {print 100 - $12 "%"}'
interval=5
label=<span color="#9ece6a"> </span>
color=#9ece6a

[volume]
command=~/dotfiles/scripts/volman.sh
interval=1
label=<span color="#f7768e"></span>
color=#f7768e

[time_madrid]
command=TZ="Europe/Madrid" date '+%H:%M<span color="#7dcfff">%Z</span>'
interval=10
label=<span color="#7dcfff">󱑒 </span>
color=#7dcfff

[time_now]
command=date '+%H:%M<span color="#7aa2f7">%Z</span>'
interval=10
label=<span color="#7aa2f7">󱑒 </span>
color=#7aa2f7
