separator=false
color="#ffff"
separator_block_width=9
markup=pango

[openpvn]
command=node ~/dotfiles/scripts/js/network_info.js | awk -F ': ' '{printf "<span color=\"#6C71C4\">%s</span> %s\n", $1, $2}'
interval=15
label=<span color="#6C71C4">  </span>

[arch_update]
command= ~/dotfiles/scripts/arch_updates.sh
interval=once
label=<span color="#268BD2"> </span>


[keyboard]
command=~/dotfiles/scripts/keyboard_layout.sh
interval=once
label=<span color="#2AA198">  </span>

[root]
command=df --output=avail / | tail -n 1 | numfmt --to=iec-i --from-unit=1024 --format="%.2f" | tr -d 'A-Za-z' 
interval=10
label=<span color="#B58900"> </span>

[cpu]
command=mpstat 1 1 | awk '/all/ {print 100 - $12 "%"}'
interval=5
label=<span color="#859900"> </span>

[volume]
command=~/dotfiles/scripts/volman.sh
interval=1
label=<span color="#D33682"></span>

[time_madrid]
command=TZ="Europe/Madrid" date '+%H : %M %Z' | awk '{ printf "%s<span color=\"#2AA198\">%s</span>%s<span color=\"#2AA198\"> %s</span>\n", $1, $2, $3, $4 }'
interval=10
label=<span color="#2AA198">󱑒 </span>


[date]
command=date '+%d %b %Y'
interval=3600
label=<span color="#DC322F">󰸘 </span>
