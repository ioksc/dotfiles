
# ---------- General settings ----------
# Default modkey:
# Mod4 = Super(Win); Mod1 = Alt; Mod2 = Shift; Mod3 = Control
set $mod Mod4
# Set Terminal Emulator(Alacritty,kitty,etc.)
set $terminal alacritty
# Default monitor set primary
set $default_monitor primary
# Custom Monitor: get monitor name --> xrandr --query | grep " connected" | cut -d " " -f1
# set $default_monitor DVI-I-2
# Set Font for window titles.
set $default_font Mononoki Nerd Font 11

# ---------- Window settings ----------
# Determines which border style new windows will have
default_border pixel 1

# Font for window titles.
font Pango: $default_font

# focus follows mouse (values: yes, no)
focus_follows_mouse yes

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Borders
gaps inner 5
gaps outer 5
smart_gaps on
hide_edge_borders smart

# ------ Window settings ------
# Keybindings Configuration
include keybinding.conf

# Workspaces Configuration
include workspaces.conf

# ------ Rules ------
include windows_rules.conf

# ---------- Colors ----------
set $base03    #002B36
set $base02    #073642
set $base01    #586E75
set $base00    #657B83
set $base0     #839496
set $base1     #93A1A1
set $base2     #EEE8D5
set $base3     #FDF6E3

# Colores de acento
set $yellow    #B58900
set $orange    #CB4B16
set $red       #DC322F
set $magenta   #D33682
set $violet    #6C71C4
set $blue      #268BD2
set $cyan      #2AA198
set $green     #859900

# Colores de fondo
set $background        #00141A
set $background_light  #002B36
# -------------------- Colors --------------------


# Configuración de colores para ventanas
client.focused          $blue       $background    $base3      $blue       $blue
client.focused_inactive $base01     $base03        $base1      $base01     $base01
client.unfocused        $base02     $background    $base00     $base02     $base02
client.urgent           $red        $red           $base3      $red        $red
client.placeholder      $base02     $background    $base00     $base02     $base02
client.background       $background

# Configuración de i3bar
bar {
    font pango: $default_font
    i3bar_command i3bar
    output $default_monitor
    position top
    status_command i3blocks
    strip_workspace_numbers yes
    workspace_buttons yes
    tray_output $default_monitor

    workspace_min_width 30
    strip_workspace_name no
    colors {
        background $background
        statusline $base3
        separator  $base01
        # workspace            border      background  text
        focused_workspace     $blue       $blue         $base3
        active_workspace      $base02     $base02       $base1
        inactive_workspace    $base03     $base03       $base00
        urgent_workspace      $red        $red          $base3
        binding_mode          $yellow     $yellow       $base3
    }
}

# ---- Startup programs -----
include startup_app.conf
