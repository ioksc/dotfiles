
# ---------- General settings ----------
# Default modkey:
# Mod4 = Super(Win); Mod1 = Alt; Mod2 = Shift; Mod3 = Control
set $mod Mod4
# Set Terminal Emulator(Alacritty,kitty,etc.)
set $terminal alacritty
# Default monitor set primary
set $default_monitor primary
# Custom Monitor: get monitor name --> xrandr --query | grep " connected" | cut -d " " -f1
# set $default_monitor DVI-I-2
# Set Font for window titles.
set $default_font JetBrainsMono Nerd Font 12

# ---------- Window settings ----------
# Determines which border style new windows will have
default_border pixel 0

# Font for window titles.
font Pango: $default_font

# focus follows mouse (values: yes, no)
focus_follows_mouse yes

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Borders
gaps outer 3
gaps inner 3
smart_gaps on
hide_edge_borders true

# ------ Window settings ------
# Keybindings Configuration
include keybinding.conf

# Workspaces Configuration
include workspaces.conf

# ------ Rules ------
include windows_rules.conf

# -------------- Cyberpunk Colors ------------------
set $bg         #0A0E14
set $fg         #C0CAF5
set $gray       #545C7E
set $cyan       #7DCFFF
set $blue       #7AA2F7
set $purple     #BB9AF7
set $pink       #F7768E
set $green      #9ECE6A
set $yellow     #E0AF68
set $orange     #FF9E64
set $red        #F7768E

# Configuración de colores para ventanas
client.focused          $cyan       $bg    $fg      $cyan       $cyan
client.focused_inactive $gray       $bg    $fg      $gray       $gray
client.unfocused        $bg         $bg    $gray    $bg         $bg
client.urgent           $red        $red   $fg      $red        $red
client.placeholder      $gray       $bg    $gray    $gray       $gray
client.background       $bg

# Configuración de i3bar
bar {
    i3bar_command $HOME/.config/polybar/launch.sh
    colors {
        background $bg
        statusline $fg
        separator  $gray
        focused_workspace     $cyan    $cyan    $bg
        active_workspace      $blue    $blue    $bg
        inactive_workspace    $bg      $bg      $gray
        urgent_workspace      $red     $red     $bg
        binding_mode          $yellow  $yellow  $bg
    }
}

# ---- Startup programs -----
include startup_app.conf
