/*
 * ROFI MacOS/Raycast Style Theme (v2.3)
 */

configuration {
    font: "Mononoki Nerd Font 12";
    width: 100%;
    show-icons: true;
    icon-theme: "Papirus";
    modi: "drun,run,window";
    terminal: "alacritty";
    hide-scrollbar: true;

    display-drun: "";
    display-run: "";
    display-window: "";
    display-ssh: "";
    matching: "fuzzy";
    sort: true;
    case-sensitive: false;
    cycle: true;
    kb-remove-to-eol: "";
    kb-accept-entry: "Return,KP_Enter";
    kb-row-up: "Up,Control+k";
    kb-row-down: "Down,Control+j";
    disable-history: false;
    dmenu {
        font: "Mononoki Nerd Font 11";
    }
}

/* --- VARIABLES GLOBALES --- */
* {
    /* Colores base */
    bg-base:      #1C1C1EF0;
    bg-alt:       #2C2C2EE6;
    bg-selected:  #007AFFE6;
    bg-hover:     #3A3A3C80;

    /* Colores de texto */
    fg-base:      #FFFFFF;
    fg-alt:       #8E8E93;
    fg-selected:  #FFFFFF;

    /* Elementos de UI */
    separator:    #38383A;
    border-color: #48484A;
    shadow:       #00000040;

    /* Reset global */
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
    background-color: transparent;
}

/* --- VENTANA PRINCIPAL --- */
window {
    background-color: @bg-base;
    border: 1px;
    border-color: @border-color;
    border-radius: 12px;
    width: 35%;
    location: center;
    anchor: center;
    transparency: "real";
    children: [ mainbox ];
}

mainbox {
    children: [ inputbar, message, listview ];
    padding: 12px;
    spacing: 8px;
}

/* --- BARRA DE ENTRADA --- */
inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px 14px;
    border: 1px;
    border-color: @separator;
}

prompt {
    enabled: true;
    str: "󰍉 ";
    text-color: @fg-alt;
    font: "SF Pro Display 12";
    vertical-align: 0.5;
    padding: 0 6px 0 0;
}

entry {
    text-color: @fg-base;
    placeholder: "...";
    placeholder-color: @fg-alt;
    font: "SF Pro Display 11";
    vertical-align: 0.5;
    cursor: text;
}

/* --- MENSAJE/SUBTÍTULO --- */
message {
    padding: 0;
    margin: 0;
    background-color: transparent;
    enabled: false;
}

textbox {
    text-color: @fg-alt;
    font: "SF Pro Display 10";
    padding: 0 2px 4px 2px;
    horizontal-align: 0;
}

/* --- LISTA DE ELEMENTOS --- */
listview {
    columns: 1;
    lines: 8;
    cycle: true;
    spacing: 2px;
    layout: vertical;
    fixed-height: false;
    scrollbar: false;
    reverse: false;
    flow: vertical;
}

element {
    orientation: horizontal;
    padding: 8px 12px;
    border-radius: 8px;
    children: [ element-icon, element-text ];
    spacing: 0;
}

element-icon {
    size: 20px;
    vertical-align: 0.5;
    margin: 0 12px 0 0;
}

element-text {
    text-color: @fg-base;
    vertical-align: 0.5;
    horizontal-align: 0;
    font: "SF Pro Display 11";
    padding: 0;
}

/* --- ESTADOS DE ELEMENTOS --- */
element.normal.normal {
    background-color: transparent;
    text-color: @fg-base;
}

element.normal.active {
    background-color: transparent;
    text-color: @fg-base;
}

element.selected.normal,
element.selected.active {
    background-color: @bg-selected;
    text-color: @fg-selected;
}

/* --- ELEMENTOS ESPECIALES --- */
element.alternate.normal {
    background-color: transparent;
    text-color: @fg-alt;
    font: "SF Pro Display Semibold 10";
    padding: 12px 12px 6px 12px;
}

element.alternate.urgent {
    background-color: @separator;
    height: 1px;
    border: 0;
    padding: 0;
    margin: 6px 0;
}

/* --- SCROLLBAR --- */
scrollbar {
    width: 3px;
    border: 0;
    handle-color: @fg-alt;
    handle-width: 3px;
    padding: 0;
}

/* --- MODO DMENU --- */
mode-switcher {
    enabled: true;
}
