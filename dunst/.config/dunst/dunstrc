[global]
    ### Display ###
    monitor = 0
    follow = mouse
    enable_posix_regex = true

    ### Geometry ###
    width = (320, 400)
    height = (80, 200)
    origin = top-right
    offset = (15, 45)
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 350
    progress_bar_corner_radius = 3
    progress_bar_corners = all

    ### Style ###
    corner_radius = 10
    corners = all
    frame_width = 2
    frame_color = "#313244"
    gap_size = 8
    separator_color = "frame"
    background = "#1e1e2eE6"
    foreground = "#CDD6F4"
    padding = 10
    horizontal_padding = 15
    text_icon_padding = 12

    ### Icons ###
    icon_corner_radius = 8
    icon_corners = all
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus"
    icon_position = left
    min_icon_size = 42
    max_icon_size = 56

    ### Text ###
    font = Inter 10
    line_height = 5
    markup = full
    format = "<b>%s</b>\n<span size='small' alpha='80%%'>%b</span>"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    ignore_newline = no
    stack_duplicates = false
    hide_duplicate_count = true
    show_indicators = false

    ### Behavior ###
    sort = update
    indicate_hidden = yes
    sticky_history = yes
    history_length = 20
    idle_threshold = 0

    ### Interaction ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, remove_current  
    mouse_right_click = context_all

    ### Applications ###
    browser = /usr/bin/xdg-open
    dmenu = /usr/bin/rofi -dmenu -p "dunst:"
    always_run_script = true

    ### Window ###
    title = "Notifications"
    class = "Dunst"
    force_xwayland = false
    force_xinerama = false

[urgency_low]
    background = "#1E1E2Ee6"
    foreground = "#CDD6F4"
    highlight = "#89B4FA"
    frame_color = "#313244"
    timeout = 5

[urgency_normal]
    background = "#1E1E2Ee6"
    foreground = "#CDD6F4"
    highlight = "#89B4FA"
    frame_color = "#89B4FA"
    timeout = 10

[urgency_critical]
    background = "#1E1E2Ee6"
    foreground = "#F38BA8"
    highlight = "#F38BA8"
    frame_color = "#F38BA8"
    timeout = 0           
### Custom Rules ###
[volume]
    appname = ".*volume.*"        
    set_stack_tag = "volume"
    timeout = 2

[brightness]
    appname = ".*brightness.*" 
    set_stack_tag = "brightness"
    timeout = 2

[music]
    appname = "(Spotify|playerctl|Chromium)"  
    set_stack_tag = "music"
    timeout = 5

[updates]
    appname = "pacman"
    urgency = normal
    timeout = 15
    set_stack_tag = "updates"

[messaging]
    appname = "(telegram|discord|Session)"
    urgency = normal
    timeout = 8
    set_stack_tag = "messaging"

[scylla_meltdown]
    summary = ".*CORE: MELTDOWN.*"
    background = "#020E0E"
    foreground = "#FB3640"
    frame_color = "#FB3640"
    timeout = 0
    set_stack_tag = "thermal_emergency"