# ========================
# 🌎 MIRRORS USA OPTIMIZADOS
# ========================
alias mirror_speed='sudo reflector \
    --protocol https \
    --country "US,CA,MX" \
    --latest 50 \
    --sort rate \
    --fastest 10 \
    --download-timeout 5 \
    --save /etc/pacman.d/mirrorlist \
    && echo "🚀 Espejos más rápidos configurados"'

alias mirror_fast='sudo reflector \
    --protocol https \
    --country "US,CA" \
    --latest 30 \
    --sort delay \
    --connection-timeout 2 \
    --save /etc/pacman.d/mirrorlist \
    && echo "📡 Espejos de baja latencia"'

alias mirror_score='sudo reflector \
    --protocol https \
    --country "US,CA,MX" \
    --latest 50 \
    --sort score \
    --save /etc/pacman.d/mirrorlist \
    && echo "🏆 Espejos mejor calificados"'

# ========================
# 🚀 GESTIÓN DE PAQUETES
# ========================
# Actualización completa
sys_update() {
    mirror_speed \
    && paru -Syyu \
    && echo "✅ Sistema actualizado" \
    && paru -Sc --noconfirm \
    && echo "🧹 Caché limpiada"
}

# Búsqueda e instalación interactiva
pkg() {
    cache_file=~/.cache/paru_pkglist
    if [[ ! -f $cache_file || $(find "$cache_file" -mtime +1 -print) ]]; then
        paru -Slq | tee "$cache_file"
    fi
    cat "$cache_file" | \
    fzf --multi --preview 'paru -Si {1}' --preview-window=wrap | \
    xargs -ro paru -S
}

# ========================
# 📁 ARCHIVOS Y DIRECTORIOS
# ========================
alias ls='eza --icons --group-directories-first --git-ignore'
alias ll='eza -a --icons --group-directories-first --color-scale'
alias lt='eza -aT --icons --level=2'


# ========================
# ⚡️ UTILIDADES ESENCIALES
# ========================
alias unlockdb='sudo rm /var/lib/pacman/db.lck 2>/dev/null && echo "🔓 Lock removido"'
alias jctl='journalctl -p 3 -xb -n 25'      # Últimos 25 errores
alias grub-update='sudo grub-mkconfig -o /boot/grub/grub.cfg && echo "🍔 GRUB actualizado"'
alias reload="exec $SHELL -l"

# ========================
# 🔒 SEGURIDAD
# ========================
alias rm='rm -iv'
alias mv='mv -i'
alias cp='cp -i'

# ========================
# 💻 DESARROLLO
# ========================
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias glc='git log --graph --abbrev-commit --oneline --decorate --all'

