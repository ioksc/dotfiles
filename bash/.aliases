# ========================
# MIRRORS OPTIMIZADOS
# ========================

_mirror() {
    local sort="$1" desc="$2"
    sudo reflector --protocol https --latest 50 --sort "$sort" --save /etc/pacman.d/mirrorlist \
        && echo "🌠 $desc"
}

alias mirror_speed='_mirror rate "Espejos más rápidos configurados"'
alias mirror_fast='_mirror delay "Espejos de baja latencia"'
alias mirror_score='_mirror score "Espejos mejor calificados"'

# ========================
# ARCHIVOS Y DIRECTORIOS
# ========================
alias ls='eza --icons --group-directories-first'
alias ll='eza -al --icons --group-directories-first --color-scale'
alias lt='eza -aT --icons --level=2'

# ========================
# UTILIDADES ESENCIALES
# ========================
alias unlockdb='sudo rm -f /var/lib/pacman/db.lck && echo "🔓 Lock removido"'
alias jctl='journalctl -p 3 -xb -n 25'
alias grub-update='sudo grub-mkconfig -o /boot/grub/grub.cfg && echo "GRUB actualizado"'
alias reload='exec $SHELL -l'
alias duf='duf -theme dark'
alias top='htop'

# ========================
# SEGURIDAD
# ========================
alias rm='rm -iv'
alias mv='mv -i'
alias cp='cp -i'
alias chmod='chmod --verbose'
alias chown='chown --verbose'
alias mcd='mkdircd() { mkdir -p "$1" && cd "$1"; }; mkdircd'

# ========================
# DESARROLLO - GIT
# ========================
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias glc='git log --graph --abbrev-commit --oneline --decorate --all'
alias gd='git diff'                    # Ver diferencias
alias gds='git diff --staged'          # Diferencias en staged
alias gb='git branch'                  # Listar ramas
alias gco='git checkout'               # Cambiar ramas
alias gcb='git checkout -b'            # Crear y cambiar a nueva rama
alias gm='git merge'                   # Combinar ramas
alias gr='git rebase'                  # Rebasear
alias gpl='git pull'                   # Pull con actualizaciones
alias gcl='git clone'                  # Clonar repositorio
alias grs='git reset --soft HEAD^'     # Deshacer último commit (manteniendo cambios)
alias grh='git reset --hard'           # Reset duro
alias grep='grep --color=auto'


# ========================
#  DOCKER
# ========================
alias docker-ps='docker ps --format "table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias docker-stop='docker stop $(docker ps -q)'  # Parar todos los contenedores
alias docker-rm='docker rm $(docker ps -aq)'     # Eliminar contenedores parados
alias docker-pull='docker pull'                  # Actualizar imágenes
alias docker-logs='docker logs -f'               # Seguir logs en tiempo real

# ========================
#  Other useful aliases
# ========================
alias burpsuite='/home/ioksc/burp-launcher.sh &>/dev/null &'
alias aleatorio='wal -i ~/Wallpapers/ &>/dev/null  && clear && fastfetch --config examples/14'