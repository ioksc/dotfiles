pkg() {
    cache_file=~/.cache/paru_pkglist
    [[ ! -f "$cache_file" || $(find "$cache_file" -mtime +1) ]] && paru -Slq > "$cache_file"
    fzf --multi --preview 'paru -Si {}' --preview-window=wrap < "$cache_file" | xargs -ro paru -S
}

tm() {
    [[ -n "$TMUX" ]] && change="switch-client" || change="attach-session"
    if [ $1 ]; then
        tmux $change -t "$1" 2>/dev/null || (tmux new-session -d -s $1 && tmux $change -t "$1"); return
    fi

    session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf --exit-0) &&
    tmux $change -t "$session" || tmux new-session
}

# Función para matar sesiones de tmux con fzf
tmk() {
    local sessions
    sessions="$(tmux ls | fzf --multi --reverse --preview 'tmux capture-pane -pt {1}' | cut -d: -f1)"
    if [[ -n "$sessions" ]]; then
        echo "$sessions" | xargs -I {} tmux kill-session -t {}
    fi
}

y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# Funciones de compresión
readonly _R='\033[0;31m' _G='\033[0;32m' _B='\033[0;34m' _Y='\033[1;33m' _N='\033[0m'
readonly _OK='✅' _ERR='❌' _INFO='ℹ️' _ZIP='📦' _WARN='⚠️'

# Mensajes
_msg() { echo -e "${2}${1}${_N}"; }
_error() { _msg "${_ERR} $1" "${_R}" >&2; }
_success() { _msg "${_OK} $1" "${_G}"; }
_info() { _msg "${_INFO} $1" "${_B}"; }

# Verificar dependencias
_check_deps() {
    local -a missing
    for dep in tar unzip gzip bzip2 xz 7z unrar; do
        command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
    done

    if ((${#missing[@]})); then
        _error "Falta instalar: ${missing[*]}"
        _info "Instalar con: sudo pacman -S ${missing[*]}"
        return 1
    fi
}

# 📤 Extraer archivos
extract() {
    local usage="
    ${_ZIP} ${_Y}Uso:${_N} extract <archivo> [destino]

    ${_INFO} Formatos: tar.bz2, tar.gz, tar.xz, zip, rar, 7z"

    [[ -z "$1" ]] && { echo -e "$usage"; return 1; }
    _check_deps || return 1

    local file="$1" dest="${2:-.}"
    [[ ! -f "$file" ]] && { _error "No existe: $file"; return 1; }

    mkdir -p "$dest" && cd "$dest" || { _error "Error accediendo a: $dest"; return 1; }

    case "${file,,}" in
        *.tar.bz2|*.tbz2) tar -xjf "$file" ;;
        *.tar.gz|*.tgz)   tar -xzf "$file" ;;
        *.tar.xz|*.txz)   tar -xJf "$file" ;;
        *.zip)            unzip "$file"    ;;
        *.rar)            unrar x "$file"  ;;
        *.7z)             7z x "$file"     ;;
        *) _error "Formato desconocido: $file"; return 1 ;;
    esac

    (($? == 0)) && _success "Extraído en: $dest" || _error "Error al extraer"
}

# Comprimir archivos
compress() {
    local usage="
    ${_ZIP} ${_Y}Uso:${_N} compress <archivo/directorio> <formato> [nombre]

    ${_INFO} Formatos:
        • zip    📦 (compatible)
        • tar.gz 🚀 (rápido)
        • tar.bz2 🗜️ (compresión alta)
        • tar.xz 💎 (mejor compresión)
        • 7z     🎯 (versátil)"

    [[ -z "$1" || -z "$2" ]] && { echo -e "$usage"; return 1; }
    _check_deps || return 1

    local src="$1" fmt="$2" out="${3:-$1}"
    [[ ! -e "$src" ]] && { _error "No existe: $src"; return 1; }

    local cmd size_before size_after tmp_err
    size_before=$(du -sh "$src" | cut -f1)

    case "$fmt" in
        zip)     cmd="zip -r"    ; fmt_name="ZIP" ;;
        tar.gz)  cmd="tar -czf"  ; fmt_name="GZIP" ;;
        tar.bz2) cmd="tar -cjf"  ; fmt_name="BZIP2" ;;
        tar.xz)  cmd="tar -cJf"  ; fmt_name="XZ" ;;
        7z)      cmd="7z a"      ; fmt_name="7ZIP" ;;
        *) _error "Formato desconocido: $fmt"; return 1 ;;
    esac

    _info "Comprimiendo con $fmt_name..."
    tmp_err=$(mktemp)  # Archivo temporal para errores

    # Desactiva mensajes de control de trabajos
    set +m
    $cmd "${out}.${fmt}" "$src" >/dev/null 2>"$tmp_err" &
    local pid=$!

    # Spinner
    local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0
    while kill -0 $pid 2>/dev/null; do
        printf "\r${_B}%s${_N} Comprimiendo..." "${spin:$i:1}"
        sleep 0.1
        ((i = (i + 1) % 10))
    done
    printf "\r\033[K"  # Limpia la línea

    wait $pid  # Captura el estado de salida
    local status=$?
    set -m  # Reactiva mensajes de control

    if (($status == 0)); then
        if [[ -e "${out}.${fmt}" ]]; then
            size_after=$(du -sh "${out}.${fmt}" | cut -f1)
            _success "Comprimido: ${out}.${fmt}"
            _info "📊 Original: $size_before → Comprimido: $size_after"
        else
            _error "El archivo comprimido no se generó."
            status=1
        fi
    else
        _error "Error al comprimir. Detalles:"
        cat "$tmp_err" >&2
    fi

    rm -f "$tmp_err"
    return $status
}



backup() {
    local HELP_TEXT="
    📦 Uso: backup <origen> <destino> [opciones]

    Opciones:
        -p, --preview    Previsualiza los cambios sin realizar la copia
        -d, --delete     Elimina archivos en destino que no existen en origen
        -v, --verbose    Muestra información detallada
        -f, --fast       Modo rápido (útil para red local)
        -c, --checksum   Verifica la integridad de los archivos
        -i, --ignore     Ignora archivos temporales y caché
        -s, --smart      Modo inteligente (auto-detecta mejor configuración)
        -z, --zip        Comprime durante la transferencia
        -l, --log        Guarda log de la operación
        -b, --bandwidth RATE  Limita el ancho de banda (ej: 1M, 500K)
        -r, --retry      Reintentos automáticos en caso de error

    Ejemplos:
        backup ~/Documentos /media/backup -s
        backup . /backup -pdv
        backup ~/Proyectos usuario@servidor:/backup -c
        backup archivo.iso /backup -fz
    "

    # Verificar que rsync está instalado
    if ! command -v rsync &>/dev/null; then
        echo "❌ Error: rsync no está instalado"
        return 1
    fi

    # Mostrar ayuda si no hay argumentos o se solicita ayuda
    if [[ "$#" -lt 2 || "$1" == "-h" || "$1" == "--help" ]]; then
        echo "$HELP_TEXT"
        return 1
    fi

    local src="$1"
    local dest="$2"
    local is_local=false
    local bandwidth=""
    local log_file=""
    local retry_opts=""
    local base_opts=(
        "--progress"      # Muestra progreso
        "--human-readable" # Tamaños legibles
        "--stats"         # Estadísticas al final
        "--timeout=180"   # Timeout para conexiones lentas
    )
    local extra_opts=()

    # Verificar que el origen existe
    if [[ ! -e "$src" ]]; then
        echo "❌ Error: El origen '$src' no existe"
        return 1
    fi

    # Detectar si es transferencia local
    if [[ "$dest" != *":"* && "$src" != *":"* ]]; then
        is_local=true
        # Verificar que el destino existe o crear si es necesario
        if [[ ! -d "$dest" ]]; then
            mkdir -p "$dest" 2>/dev/null || {
                echo "❌ Error: No se puede crear el directorio destino"
                return 1
            }
        fi
    fi

    shift 2  # Mover a las opciones

    # Procesar opciones
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -p|--preview)
                extra_opts+=("--dry-run")
                ;;
            -d|--delete)
                extra_opts+=("--delete" "--delete-excluded")
                ;;
            -v|--verbose)
                extra_opts+=("--verbose" "--info=progress2")
                ;;
            -f|--fast)
                if $is_local; then
                    extra_opts+=("--whole-file")
                else
                    extra_opts+=("--compress")
                fi
                ;;
            -c|--checksum)
                extra_opts+=("--checksum")
                ;;
            -i|--ignore)
                extra_opts+=(
                    "--exclude='.git/*'"
                    "--exclude='.cache/*'"
                    "--exclude='node_modules/*'"
                    "--exclude='*.tmp'"
                    "--exclude='*.temp'"
                    "--exclude='*.swp'"
                    "--exclude='*~'"
                    "--exclude='.DS_Store'"
                    "--exclude='Thumbs.db'"
                )
                ;;
            -s|--smart)
                if $is_local; then
                    extra_opts+=("--whole-file")
                else
                    extra_opts+=(
                        "--compress"
                        "--compress-level=6"
                        "--partial"
                        "--partial-dir=.rsync-partial"
                    )
                fi
                extra_opts+=(
                    "--exclude='.git/*'"
                    "--exclude='.cache/*'"
                    "--exclude='*.tmp'"
                )
                retry_opts="--timeout=180 --contimeout=60"
                ;;
            -z|--zip)
                extra_opts+=("--compress" "--compress-level=9")
                ;;
            -l|--log)
                log_file="/tmp/backup-$(date +%Y%m%d-%H%M%S).log"
                ;;
            -b|--bandwidth)
                shift
                if [[ -n "$1" ]]; then
                    bandwidth="--bwlimit=$1"
                    extra_opts+=("$bandwidth")
                fi
                ;;
            -r|--retry)
                retry_opts="--timeout=180 --contimeout=60 --retry-connrefused --retry=3"
                extra_opts+=($retry_opts)
                ;;
            *)
                echo "❌ Opción desconocida: $1"
                echo "$HELP_TEXT"
                return 1
                ;;
        esac
        shift
    done

    # Configuración base según el tipo de transferencia
    if $is_local; then
        base_opts+=("--archive")  # Modo archivo para preservar atributos
    else
        base_opts+=(
            "--archive"          # Modo archivo
            "--partial"          # Mantener transferencias parciales
            "--partial-dir=.rsync-partial"  # Directorio para archivos parciales
            "--compress-level=6" # Compresión moderada por defecto
        )
    fi

    # Preparar y ejecutar el comando
    local cmd="rsync ${base_opts[*]} ${extra_opts[*]} \"$src\" \"$dest\""

    # Mostrar información de la transferencia
    echo "🚀 Iniciando transferencia..."
    echo "📂 Origen: $src"
    echo "📁 Destino: $dest"
    [[ -n "$bandwidth" ]] && echo "🌐 Límite de ancho de banda: $bandwidth"
    [[ -n "$retry_opts" ]] && echo "🔄 Reintentos automáticos activados"
    [[ " ${extra_opts[*]} " =~ "--dry-run" ]] && echo "🔍 Modo preview activado"

    # Ejecutar el comando y manejar la salida
    if [[ -n "$log_file" ]]; then
        echo "📝 Guardando log en: $log_file"
        eval "$cmd" 2>&1 | tee "$log_file"
        status=${PIPESTATUS[0]}
    else
        eval "$cmd"
        status=$?
    fi

    # Mostrar resultado
    if [ $status -eq 0 ]; then
        echo "✅ Transferencia completada exitosamente"
        [[ -n "$log_file" ]] && echo "📝 Log guardado en: $log_file"
    else
        echo "❌ Error durante la transferencia (código: $status)"
        [[ -n "$log_file" ]] && echo "📝 Consulta el log en: $log_file"
    fi

    return $status
}

# Función para copias rápidas
qcopy() {
    backup "$1" "$2" --fast --smart
}

# Función para sincronización segura
safesync() {
    backup "$1" "$2" --checksum --smart --retry
}

# Función para previsualizar cambios
preview_sync() {
    backup "$1" "$2" --preview --verbose
}

# Función para copias con log
logcopy() {
    backup "$1" "$2" --smart --log
}

# Función para copias lentas/throttled
slowcopy() {
    backup "$1" "$2" --bandwidth 1M --smart
}
