# Funciones mejoradas de bashrc
ranger() {
    local tempfile
    tempfile=$(mktemp) || return 1

    trap "rm -f '$tempfile'" EXIT INT TERM
    command ranger --choosedir="$tempfile" "${@:-$PWD}"
    if [[ -s "$tempfile" ]]; then
        local dir
        dir=$(<"$tempfile")

        [[ "$dir" != "$PWD" ]] && cd "$dir"
    fi

    trap - EXIT INT TERM
}
# 📦 pkg: Busca e instala paquetes de AUR con fzf y caché
pkg() {
    local cache_file="$HOME/.cache/paru_pkglist"
    local cache_time=86400 # 24 horas en segundos

    # Crear directorio de caché si no existe
    mkdir -p "$(dirname "$cache_file")"

    # Verificar si el archivo de caché no existe o es antiguo (más de 24 horas)
    if [[ ! -f "$cache_file" || $(( $(date +%s) - $(stat -c %Y "$cache_file") )) -gt "$cache_time" ]]; then
        _info "Actualizando lista de paquetes de AUR..."
        if ! paru -Slq > "$cache_file"; then
            _error "Error al actualizar la lista de paquetes."
            return 1
        fi
        _success "Lista de paquetes de AUR actualizada."
    fi

    fzf --multi \
        --preview 'paru -Si {}' \
        --preview-window=wrap \
        --prompt='Buscar paquetes AUR > ' \
        --bind 'ctrl-a:select-all,ctrl-d:deselect-all' \
        --header "Usa Ctrl-a para seleccionar todo, Ctrl-d para deseleccionar todo" < "$cache_file" |
    xargs -ro paru -S
}

# 📌 tm: Gestiona sesiones de tmux con facilidad
tm() {
    local session_name="$1"
    local change_cmd="attach-session"

    # Determinar si estamos dentro de una sesión tmux
    [[ -n "$TMUX" ]] && change_cmd="switch-client"

    # Si se proporciona un nombre de sesión
    if [[ -n "$session_name" ]]; then
        # Intentar conectar a la sesión existente o crear una nueva
        tmux $change_cmd -t "$session_name" 2>/dev/null ||
            { tmux new-session -d -s "$session_name" && tmux $change_cmd -t "$session_name"; }
        return 0
    fi

    # Si no se proporciona nombre, mostrar selector con fzf
    local session
    session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf --exit-0 --prompt='Sesiones tmux > ')

    # Conectar a la sesión seleccionada o crear una nueva
    if [[ -n "$session" ]]; then
        tmux $change_cmd -t "$session"
    else
        tmux new-session
    fi
}

# tmk: Mata sesiones de tmux con fzf
tmk() {
    # Listar y permitir selección múltiple de sesiones
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null |
            fzf --multi \
                --reverse \
                --prompt='Matar sesión(es) tmux > ' \
                --preview 'tmux capture-pane -pt {} -S -30' \
                --preview-window=wrap,right,70% \
                --header "Selecciona las sesiones a matar (Multi-selección con TAB)")

    # Matar las sesiones seleccionadas
    if [[ -n "$sessions" ]]; then
        echo "$sessions" | xargs -I {} tmux kill-session -t {} &&
            _success "Sesión(es) tmux eliminada(s)."
    else
        _info "No se seleccionaron sesiones para matar."
    fi
}

# y: Navegador de archivos Yazi con integración cd
y() {
    local tmp_file="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp_file"

    local cwd="$(cat "$tmp_file")"
    if [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp_file" &>/dev/null
}


# ==============================================================================
# Funciones de Backup (rsync)
# ==============================================================================

_rsync_check() {
    if ! command -v rsync &>/dev/null; then
        _error "rsync no está instalado. Por favor, instálalo."
        return 1
    fi
    return 0
}

_backup_usage() {
    cat <<EOF
${_ZIP} ${_Y}Uso: backup <origen> <destino> [opciones]${_N}

Opciones:
    -p, --preview    Previsualiza los cambios sin realizar la copia
    -d, --delete     Elimina archivos en destino que no existen en origen
    -v, --verbose    Muestra información detallada
    -f, --fast       Modo rápido (útil para red local)
    -c, --checksum   Verifica la integridad de los archivos
    -i, --ignore     Ignora archivos temporales y caché
    -s, --smart      Modo inteligente (auto-detecta mejor configuración)
    -z, --zip        Comprime durante la transferencia
    -l, --log        Guarda log de la operación
    -b, --bandwidth RATE  Limita el ancho de banda (ej: 1M, 500K)
    -r, --retry      Reintentos automáticos en caso de error

Ejemplos:
    backup ~/Documentos /media/backup -s
    backup . /backup -pdv
    backup ~/Proyectos usuario@servidor:/backup -c
    backup archivo.iso /backup -fz
EOF
}


backup() {
    _rsync_check || return 1

    if [[ "$#" -lt 2 || "$1" == "-h" || "$1" == "--help" ]]; then
        _backup_usage
        return 1
    fi

    local src="$1"
    local dest="$2"
    shift 2
    local options=()
    local bandwidth=""
    local log_file=""
    local dry_run=false
    local delete=false
    local verbose=false
    local fast_mode=false
    local checksum=false
    local ignore_default=false
    local smart_mode=false
    local compress_mode=false
    local retry_mode=false

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -p|--preview)    dry_run=true; options+=("--dry-run"); shift ;;
            -d|--delete)     delete=true;  options+=("--delete" "--delete-excluded"); shift ;;
            -v|--verbose)    verbose=true; options+=("--verbose" "--info=progress2"); shift ;;
            -f|--fast)       fast_mode=true; options+=("--whole-file"); shift ;;
            -c|--checksum)   checksum=true; options+=("--checksum"); shift ;;
            -i|--ignore)     ignore_default=true; shift ;;
            -s|--smart)      smart_mode=true; shift ;;
            -z|--zip)        compress_mode=true; options+=("--compress" "--compress-level=9"); shift ;;
            -l|--log)        log_file="/tmp/backup-$(date +%Y%m%d-%H%M%S).log"; shift ;;
            -b|--bandwidth)
                shift
                bandwidth="--bwlimit=$1"
                options+=("$bandwidth")
                ;;
            -r|--retry)      retry_mode=true; options+=("--timeout=180" "--contimeout=60" "--retry-connrefused" "--retry=3"); shift ;;
            *)
                _error "Opción desconocida: $1"
                _backup_usage
                return 1
                ;;
        esac
    done


    if [[ ! -e "$src" ]]; then
        _error "Origen no encontrado: '$src'"
        return 1
    fi

    local is_local=false
    if [[ "$dest" != *":"* && "$src" != *":"* ]]; then
        is_local=true
        if [[ ! -d "$dest" ]]; then
            mkdir -p "$dest" || { _error "No se pudo crear el destino: '$dest'"; return 1; }
        fi
    fi


    local rsync_opts=(
        "--archive"
        "--progress"
        "--human-readable"
        "--stats"
        "--timeout=300" # Timeout 5 minutos
    )


    if $smart_mode; then
        rsync_opts+=(
            "--compress"
            "--compress-level=6"
            "--partial"
            "--partial-dir=.rsync-partial"
        )
        ignore_default=true # Smart mode implies ignore default
    elif ! $is_local && ! $fast_mode && ! $compress_mode; then
        rsync_opts+=("--compress" "--compress-level=6") # Compresión moderada por defecto en remoto/no-fast
    fi


    if $ignore_default; then
        rsync_opts+=(
            "--exclude='.git/*'"
            "--exclude='.cache/*'"
            "--exclude='node_modules/*'"
            "--exclude='*.tmp'"
            "--exclude='*.temp'"
            "--exclude='*.swp'"
            "--exclude='*~'"
            "--exclude='.DS_Store'"
            "--exclude='Thumbs.db'"
        )
    fi


    rsync_opts+=("${options[@]}")

    local rsync_cmd="rsync \"$src\" \"$dest\" ${rsync_opts[*]}"

    _info "Iniciando backup..."
    _info "  Origen: ${_Y}$src${_N}"
    _info "  Destino: ${_Y}$dest${_N}"
    if [[ -n "$bandwidth" ]]; then _info "  Ancho de banda limitado: ${_Y}$bandwidth${_N}"; fi
    if $dry_run; then _info "  ${_Y}PREVIEW MODE ACTIVADO${_N}"; fi
    if $delete; then _warn "  Opción ${_Y}--delete${_N} ACTIVADA. ¡Archivos en destino podrían ser eliminados!"; fi
    if $retry_mode; then _info "  Reintentos automáticos activados."; fi
    if [[ -n "$log_file" ]]; then _info "  Guardando log en: ${_Y}$log_file${_N}"; fi


    if [[ -n "$log_file" ]]; then
        eval "$rsync_cmd" 2>&1 | tee "$log_file"
        local status=${PIPESTATUS[0]}
    else
        eval "$rsync_cmd"
        local status=$?
    fi


    if [[ $status -eq 0 ]]; then
        _success "Backup completado exitosamente."
        [[ -n "$log_file" ]] && _info "Log guardado en: ${_Y}$log_file${_N}"
    else
        _error "Error durante el backup (código: $status)."
        [[ -n "$log_file" ]] && _info "Revisa el log para más detalles: ${_Y}$log_file${_N}"
    fi
    return $status
}


# Funciones de copia rápida
qcopy() { backup "$1" "$2" --fast --smart; }
# Función de sincronización segura
safesync() { backup "$1" "$2" --checksum --smart --retry; }
# Función de previsualización de sincronización
preview_sync() { backup "$1" "$2" --preview --verbose; }
# Función de copia con log
logcopy() { backup "$1" "$2" --smart --log; }
# Función de copia lenta/limitada
slowcopy() { backup "$1" "$2" --bandwidth 1M --smart; }

get_window_info() {
    echo "Haz clic en la ventana..."
    xprop | awk '
    /^WM_CLASS/ {
        sub(/.* =/, "instance: ");
        sub(/,/, "\nclass: ");
        print $0
    }
    /^WM_NAME/ {
        sub(/.* =/, "title: ");
        print $0
    }
    /_NET_WM_WINDOW_TYPE\(ATOM\)/ {
        gsub(/.*\//, "type: ", $2);
        print $2
    }
    /WM_WINDOW_ROLE\(STRING\)/ {
        sub(/.* =/, "role: ");
        print $0
    }'
}

lastmodified() {
    local n=${1:-10}
    find . -type f -printf '%T@ %p\n' | sort -n | tail -n "$n" | awk '{gsub(/^[0-9]+\.[0-9]+\s+/, ""); print}'
}

mt() {
    local d
    d=$(mktemp -d "/tmp/p$$.XXXXXX")
    if [[ -d "$d" ]]; then
        trap "rm -rf '$d'" EXIT
        cd "$d" || return 1        
    else
        echo "[x] Error: No se pudo crear el directorio temporal" >&2
        return 1
    fi
}

mcd() {
    mkdir -p "$1" && cd "$1"
}

field() {
    local field_num=${1:-1}
    local separator=${2:- }
    awk -F "$separator" "{print \$$field_num}"
}

total() {
    awk '{sum += $1} END {print sum}'
}

wttr() {
    local req="wttr.in/${1:-}"
    [[ $(tput cols) -lt 125 ]] && req+="?n"
    curl -H "Accept-Language: ${LANG%_*}" --compressed "$req"
}

ports() {
    sudo ss -tulpn | grep LISTEN
}
